NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Keep this in the server environment only.
MONGODB_URI=

# Frontend URL and API URL. CLIENT_ORIGIN/BETTER_AUTH_URL are accepted aliases
# for hosts that already use the Prompt 01 variable names.
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
# CLIENT_ORIGIN=http://localhost:3000
# BETTER_AUTH_URL=http://localhost:4000

# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Existing integrations are optional for server startup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IMGBB_API_KEY=
