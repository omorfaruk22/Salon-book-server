NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Keep this in the server environment only.
MONGODB_URI=

# Public frontend origin and API service origin. Better Auth is exposed at
# CLIENT_URL/api/auth through the Next.js same-origin /api rewrite.
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
# CLIENT_ORIGIN=http://localhost:3000
# BETTER_AUTH_URL=http://localhost:4000

# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Google OAuth is enabled only when both credentials are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Hosted Checkout. Use test keys locally and production keys only in the host's secret settings.
# Register a Stripe webhook endpoint at https://YOUR_API_HOST/api/transactions/webhook
# with checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, and charge.refunded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Image uploads are optional for server startup.
IMGBB_API_KEY=
