{
  "name": "salonbook-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/admin-service-validation.test.ts tests/service-deletion.test.ts tests/admin-authorization.test.ts",
    "admin:promote": "tsx src/scripts/promote-admin.ts",
    "seed:services": "tsx src/scripts/seed-services.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.25",
    "better-auth": "^1.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.18",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.9.0",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "stripe": "^17.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
